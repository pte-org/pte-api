# Local-dev-only edge: reproduces gateway's old host port 8080 and
# /api/{name}/** stripping so pte-web's hardcoded API_BASE_URL default
# (http://localhost:8080) and scripts/seed-e2e.ps1 keep working unmodified
# after gateway-removal, without either needing to know app moved to a bare
# path contract. Plain HTTP, no ACME/TLS — `:8080` is a port-only address,
# so Caddy never attempts automatic HTTPS for it.
:8080 {
	import api-routes.caddy

	handle /actuator/* {
		reverse_proxy app:8091
	}
}
