# Copy to pte-api/.env on the deploy host (already covered by .gitignore).
# This file is the only thing that differs between deploy targets — moving the
# stack to another VM means copying it across and running compose again.
#
#   cp deploy/env.template .env && $EDITOR .env

# --- Public origins -----------------------------------------------------------
# Three separate hosts, not paths on one: MinIO's presigned URLs sign the Host
# header, so it needs its own origin (see deploy/Caddyfile).
TENANT_DOMAIN=pte-tenant.duckdns.org
ADMIN_DOMAIN=pte-admin.duckdns.org
MEDIA_DOMAIN=pte-media.duckdns.org

# Let's Encrypt uses this for expiry warnings. A wrong address does not block
# issuance, but it is the only notice you get before a cert lapses.
ACME_EMAIL=you@example.com

# --- Credentials --------------------------------------------------------------
# Every value below has a weak default in the base compose files, meant for a
# laptop. On a shared host they must be replaced: the DB/broker/object-store
# ports are published to the host, so anything else running on that machine can
# reach them even though the VCN firewall keeps the internet out.
#
# Generate with:  openssl rand -base64 24
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME

RABBITMQ_USER=pte
RABBITMQ_PASSWORD=CHANGE_ME

MINIO_ROOT_USER=pte-minio-admin
MINIO_ROOT_PASSWORD=CHANGE_ME

# --- /internal/** shared keys -------------------------------------------------
# These two have no weak default — they have a PUBLIC one. Every service's
# application.yml falls back to `dev-internal-service-key-change-me`, a literal
# committed to this repo, and the base compose files never override it. The
# /internal/** endpoints live under the /api/{service} context path, so the
# gateway serves them to the open internet.
#
# docker-compose.deploy.yml marks both `:?`, so compose refuses to start if they
# are missing rather than booting with an empty key.
INTERNAL_SERVICE_KEY=CHANGE_ME
INTERNAL_BOOTSTRAP_KEY=CHANGE_ME
