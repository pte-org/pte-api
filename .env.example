# Public configuration template only.
#
# Copy this file to .env.local for local development or inject the variables
# from a secret manager in CI/CD. Do not commit either copied file. Every value
# marked __REQUIRED__ must be replaced before starting any compose stack.

# ---------------------------------------------------------------------------
# RabbitMQ credentials
# ---------------------------------------------------------------------------
RABBITMQ_USER=__REQUIRED__
RABBITMQ_PASSWORD=__REQUIRED__

# ---------------------------------------------------------------------------
# App database credentials (pg-monolith, single database `pte`)
# ---------------------------------------------------------------------------
APP_DB_USER=__REQUIRED__
APP_DB_PASSWORD=__REQUIRED__

# ---------------------------------------------------------------------------
# App signing/encryption keys (com.pte.identity JWT signing, com.pte.attempt
# STRICT answerIntegrityLevel encryption). PEM-encoded, single-line with \n
# escapes or a heredoc depending on how your secret manager stores multiline
# values.
# ---------------------------------------------------------------------------
IDENTITY_RSA_PRIVATE_KEY_PEM=__REQUIRED__
ATTEMPT_ENCRYPTION_PRIVATE_KEY_PEM=__REQUIRED__
ATTEMPT_ENCRYPTION_PUBLIC_KEY_PEM=__REQUIRED__

# ---------------------------------------------------------------------------
# PayOS payment-link integration
# ---------------------------------------------------------------------------
PAYOS_CLIENT_ID=__REQUIRED__
PAYOS_API_KEY=__REQUIRED__
PAYOS_CHECKSUM_KEY=__REQUIRED__
PAYOS_RETURN_URL=__REQUIRED__
PAYOS_CANCEL_URL=__REQUIRED__
# PAYOS_BASE_URL=https://api-merchant.payos.vn

# SMTP/provider email. Local compose defaults to Mailpit; set these for a real provider.
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=__REQUIRED_FOR_PROVIDER__
MAIL_PASSWORD=__REQUIRED_FOR_PROVIDER__
MAIL_FROM=no-reply@example.com
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
MAIL_SMTP_STARTTLS_REQUIRED=true
TENANT_APPLICATION_RESPONSE_SLA_HOURS=72

# Cloudinary authoring media
CLOUDINARY_CLOUD_NAME=__REQUIRED__
CLOUDINARY_API_KEY=__REQUIRED__
CLOUDINARY_API_SECRET=__REQUIRED__
CLOUDINARY_AUTHORING_FOLDER=pte/question-media
CLOUDINARY_SUBMISSION_FOLDER=pte/pte/submissions
# Optional request limits (redeem is intentionally stricter than the default).
# RATE_LIMIT_PER_SECOND=40
# REDEEM_RATE_LIMIT_PER_SECOND=5
# BILLING_LICENSE_CODE_EXPIRATION_CRON=0 15 * * * *

# ---------------------------------------------------------------------------
# Hosted deployment metadata (not secrets, required by docker-compose.deploy.yml)
# ---------------------------------------------------------------------------
TENANT_DOMAIN=__REQUIRED__
ADMIN_DOMAIN=__REQUIRED__
ACME_EMAIL=__REQUIRED__

# Optional AI provider secret. Keep the local provider as stub until configured.
# SCORING_AI_API_KEY=__REQUIRED_WHEN_AI_IS_ENABLED__
