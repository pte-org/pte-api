# Public configuration template only.
#
# Copy this file to .env.local for local development or inject the variables
# from a secret manager in CI/CD. Do not commit either copied file. Every value
# marked __REQUIRED__ must be replaced before starting any compose stack.

# ---------------------------------------------------------------------------
# Postgres bootstrap
# ---------------------------------------------------------------------------
POSTGRES_USER=__REQUIRED__
POSTGRES_PASSWORD=__REQUIRED__

# ---------------------------------------------------------------------------
# RabbitMQ and MinIO credentials
# ---------------------------------------------------------------------------
RABBITMQ_USER=__REQUIRED__
RABBITMQ_PASSWORD=__REQUIRED__
MINIO_ROOT_USER=__REQUIRED__
MINIO_ROOT_PASSWORD=__REQUIRED__

# ---------------------------------------------------------------------------
# Service database credentials
# ---------------------------------------------------------------------------
IAM_DB_USER=__REQUIRED__
IAM_DB_PASSWORD=__REQUIRED__
ADMIN_DB_USER=__REQUIRED__
ADMIN_DB_PASSWORD=__REQUIRED__
AUTHORING_DB_USER=__REQUIRED__
AUTHORING_DB_PASSWORD=__REQUIRED__
SCHEDULING_DB_USER=__REQUIRED__
SCHEDULING_DB_PASSWORD=__REQUIRED__
REPORTING_DB_USER=__REQUIRED__
REPORTING_DB_PASSWORD=__REQUIRED__
NOTIFICATION_DB_USER=__REQUIRED__
NOTIFICATION_DB_PASSWORD=__REQUIRED__
MEDIA_DB_USER=__REQUIRED__
MEDIA_DB_PASSWORD=__REQUIRED__
EXAM_DELIVERY_DB_USER=__REQUIRED__
EXAM_DELIVERY_DB_PASSWORD=__REQUIRED__
PROCTOR_DB_USER=__REQUIRED__
PROCTOR_DB_PASSWORD=__REQUIRED__
SCORING_DB_USER=__REQUIRED__
SCORING_DB_PASSWORD=__REQUIRED__

# ---------------------------------------------------------------------------
# Service-to-service credentials
# ---------------------------------------------------------------------------
INTERNAL_SERVICE_KEY=__REQUIRED__
INTERNAL_BOOTSTRAP_KEY=__REQUIRED__

# ---------------------------------------------------------------------------
# Hosted deployment metadata (not secrets, required by docker-compose.deploy.yml)
# ---------------------------------------------------------------------------
TENANT_DOMAIN=__REQUIRED__
ADMIN_DOMAIN=__REQUIRED__
MEDIA_DOMAIN=__REQUIRED__
ACME_EMAIL=__REQUIRED__

# Optional AI provider secret. Keep the local provider as stub until configured.
# SCORING_AI_API_KEY=__REQUIRED_WHEN_AI_IS_ENABLED__
