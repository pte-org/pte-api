# pte-api — root .env for `docker-compose.yml` (infra) + all Spring services.
# Copy to `.env`, fill in real secrets, never commit the result.

# ---------------------------------------------------------------------------
# Infra — Postgres (docker-compose.yml)
# ---------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# Infra — Redis
# ---------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379

# ---------------------------------------------------------------------------
# Infra — MinIO (object storage, used by media service)
# ---------------------------------------------------------------------------
MINIO_ROOT_USER=pte-minio-admin
MINIO_ROOT_PASSWORD=pte-minio-dev-pw
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=http://localhost:9000
MEDIA_BUCKET=pte-media

# ---------------------------------------------------------------------------
# Infra — Mailpit (dev SMTP catcher, used by notification service)
# ---------------------------------------------------------------------------
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
MAIL_HOST=localhost
MAIL_PORT=1025

# ---------------------------------------------------------------------------
# Infra — RabbitMQ (work queue, ADR-002)
# ---------------------------------------------------------------------------
RABBITMQ_USER=pte
RABBITMQ_PASSWORD=pte
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672

# ---------------------------------------------------------------------------
# Infra — Kafka / Schema Registry / Debezium (event backbone, ADR-002)
# ---------------------------------------------------------------------------
KAFKA_PORT=9092
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
SCHEMA_REGISTRY_PORT=8091
DEBEZIUM_PORT=8092

# ---------------------------------------------------------------------------
# Infra — Jaeger (tracing UI + OTLP collector)
# ---------------------------------------------------------------------------
JAEGER_UI_PORT=16686
JAEGER_OTLP_GRPC_PORT=4317
JAEGER_OTLP_HTTP_PORT=4318
OTLP_ENDPOINT=http://localhost:4318/v1/traces

# ---------------------------------------------------------------------------
# Cross-service — auth + service-to-service call auth
# ---------------------------------------------------------------------------
IAM_JWKS_URI=http://localhost:8081/api/iam/auth/jwks
INTERNAL_SERVICE_KEY=dev-internal-service-key-change-me

# ---------------------------------------------------------------------------
# Gateway (:8080)
# ---------------------------------------------------------------------------
GATEWAY_PORT=8080
RATE_REPLENISH=20
RATE_BURST=40
IAM_URI=http://localhost:8081
ADMIN_URI=http://localhost:8082
AUTHORING_URI=http://localhost:8083
SCHEDULING_URI=http://localhost:8084
EXAM_DELIVERY_URI=http://localhost:8085
PROCTOR_URI=http://localhost:8086
PROCTOR_WS_URI=ws://localhost:8086
SCORING_URI=http://localhost:8087
REPORTING_URI=http://localhost:8088
NOTIFICATION_URI=http://localhost:8089
MEDIA_URI=http://localhost:8090

# ---------------------------------------------------------------------------
# iam service (:8081)
# ---------------------------------------------------------------------------
IAM_PORT=8081
IAM_DB_URL=jdbc:postgresql://localhost:5432/iam
IAM_DB_USER=iam_svc
IAM_DB_PASSWORD=iam_dev_pw

# ---------------------------------------------------------------------------
# admin service (:8082)
# ---------------------------------------------------------------------------
ADMIN_PORT=8082
ADMIN_DB_URL=jdbc:postgresql://localhost:5432/admin
ADMIN_DB_USER=admin_svc
ADMIN_DB_PASSWORD=admin_dev_pw

# ---------------------------------------------------------------------------
# authoring service (:8083)
# ---------------------------------------------------------------------------
AUTHORING_PORT=8083
AUTHORING_DB_URL=jdbc:postgresql://localhost:5432/authoring
AUTHORING_DB_USER=authoring_svc
AUTHORING_DB_PASSWORD=authoring_dev_pw

# ---------------------------------------------------------------------------
# scheduling service (:8084)
# ---------------------------------------------------------------------------
SCHEDULING_PORT=8084
SCHEDULING_DB_URL=jdbc:postgresql://localhost:5432/scheduling
SCHEDULING_DB_USER=scheduling_svc
SCHEDULING_DB_PASSWORD=scheduling_dev_pw
AUTHORING_URL=http://localhost:8083/api/authoring

# ---------------------------------------------------------------------------
# exam-delivery service (:8085)
# ---------------------------------------------------------------------------
EXAM_DELIVERY_PORT=8085
EXAM_DELIVERY_DB_URL=jdbc:postgresql://localhost:5432/exam_delivery
EXAM_DELIVERY_DB_USER=exam_delivery_svc
EXAM_DELIVERY_DB_PASSWORD=exam_delivery_dev_pw
SCHEDULING_URL=http://localhost:8084/api/scheduling

# ---------------------------------------------------------------------------
# proctor service (:8086)
# ---------------------------------------------------------------------------
PROCTOR_PORT=8086
PROCTOR_DB_URL=jdbc:postgresql://localhost:5432/proctor
PROCTOR_DB_USER=proctor_svc
PROCTOR_DB_PASSWORD=proctor_dev_pw
PROCTOR_WS_ALLOWED_ORIGINS=http://localhost:*

# ---------------------------------------------------------------------------
# scoring service (:8087)
# ---------------------------------------------------------------------------
SCORING_PORT=8087
SCORING_DB_URL=jdbc:postgresql://localhost:5432/scoring
SCORING_DB_USER=scoring_svc
SCORING_DB_PASSWORD=scoring_dev_pw

# ---------------------------------------------------------------------------
# reporting service (:8088)
# ---------------------------------------------------------------------------
REPORTING_PORT=8088
REPORTING_DB_URL=jdbc:postgresql://localhost:5432/reporting
REPORTING_DB_USER=reporting_svc
REPORTING_DB_PASSWORD=reporting_dev_pw

# ---------------------------------------------------------------------------
# notification service (:8089)
# ---------------------------------------------------------------------------
NOTIFICATION_PORT=8089
NOTIFICATION_DB_URL=jdbc:postgresql://localhost:5432/notification
NOTIFICATION_DB_USER=notification_svc
NOTIFICATION_DB_PASSWORD=notification_dev_pw

# ---------------------------------------------------------------------------
# media service (:8090)
# ---------------------------------------------------------------------------
MEDIA_PORT=8090
MEDIA_DB_URL=jdbc:postgresql://localhost:5432/media
MEDIA_DB_USER=media_svc
MEDIA_DB_PASSWORD=media_dev_pw
