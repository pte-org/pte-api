# =============================================================================
# PTE platform - environment template (public, committed). Every variable the backend, Compose and
# the hosted stack read is listed here with its built-in default, so nothing is tuned in code.
#
# Copy to .env.local (local Docker) or .env (VPS, mode 600) and replace every __REQUIRED__ value.
# Never commit the copies. Do not leave a variable empty unless the comment says empty is allowed:
# for numbers, durations and crons an empty value is not the same as the default.
#
# Formats: durations accept 500ms, 10s, 15m, 24h; crons have six fields (second minute hour day month weekday).
# Only variables listed in docker-compose.services.yml reach the backend container.
# =============================================================================

# -----------------------------------------------------------------------------
# Runtime and local ports (host side of the Compose port mappings)
# -----------------------------------------------------------------------------
# Spring profiles for the app container; empty = production behaviour. Local: local or local-schema.
APP_SPRING_PROFILES=
APP_PORT=8091
POSTGRES_PORT=5432
REDIS_PORT=6379
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
NGINX_PORT=8080
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# -----------------------------------------------------------------------------
# Hosted deployment (docker-compose.deploy.yml, Caddy)
# -----------------------------------------------------------------------------
TENANT_DOMAIN=__REQUIRED__
ADMIN_DOMAIN=__REQUIRED__
PRACTICE_DOMAIN=__REQUIRED__
ACME_EMAIL=__REQUIRED__

# -----------------------------------------------------------------------------
# Database, cache and message broker
# -----------------------------------------------------------------------------
APP_DB_USER=__REQUIRED__
APP_DB_PASSWORD=__REQUIRED__
APP_DB_POOL_SIZE=10
RABBITMQ_USER=__REQUIRED__
RABBITMQ_PASSWORD=__REQUIRED__

# -----------------------------------------------------------------------------
# Signing and encryption keys (PEM; single line with \n escapes or as your secret manager stores them)
# -----------------------------------------------------------------------------
IDENTITY_RSA_PRIVATE_KEY_PEM=__REQUIRED__
ATTEMPT_ENCRYPTION_PRIVATE_KEY_PEM=__REQUIRED__
ATTEMPT_ENCRYPTION_PUBLIC_KEY_PEM=__REQUIRED__

# -----------------------------------------------------------------------------
# Web origins
# -----------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3014

# -----------------------------------------------------------------------------
# Sign-in, tokens and password reset
# -----------------------------------------------------------------------------
# Token lifetimes in seconds; the refresh token must outlive the access token. Applies to newly issued tokens.
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=604800
# Wrong passwords for one account from one address before sign-in is refused until the window ends.
LOGIN_FAILURE_LIMIT=5
LOGIN_LOCK_WINDOW=15m
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
PASSWORD_RESET_RETENTION_DAYS=7
# Reset requests per e-mail and per client address within the window; more are ignored quietly.
PASSWORD_RESET_EMAIL_LIMIT=3
PASSWORD_RESET_IP_LIMIT=10
PASSWORD_RESET_THROTTLE_WINDOW=15m
PASSWORD_RESET_MAIL_MAX_THREADS=4
PASSWORD_RESET_MAIL_QUEUE_CAPACITY=200

# -----------------------------------------------------------------------------
# Request rate limits (per client, per second)
# -----------------------------------------------------------------------------
RATE_LIMIT_PER_SECOND=40
REDEEM_RATE_LIMIT_PER_SECOND=5

# -----------------------------------------------------------------------------
# E-mail (local Compose uses Mailpit: MAIL_HOST=mailpit, MAIL_PORT=1025, auth and TLS off)
# -----------------------------------------------------------------------------
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=__REQUIRED_FOR_PROVIDER__
MAIL_PASSWORD=__REQUIRED_FOR_PROVIDER__
MAIL_FROM=no-reply@example.com
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
MAIL_SMTP_STARTTLS_REQUIRED=true
MAIL_SMTP_CONNECTION_TIMEOUT_MS=5000
MAIL_SMTP_TIMEOUT_MS=10000
MAIL_SMTP_WRITE_TIMEOUT_MS=10000
MANAGEMENT_HEALTH_MAIL_ENABLED=false

# -----------------------------------------------------------------------------
# Notifications
# -----------------------------------------------------------------------------
# E-mail send retries before the message goes to the dead-letter queue.
NOTIFICATION_EMAIL_RETRY_MAX_ATTEMPTS=3
NOTIFICATION_EMAIL_RETRY_INITIAL_INTERVAL_MS=2000
NOTIFICATION_EMAIL_RETRY_MAX_INTERVAL_MS=10000
# In-app inbox worker: enable only after the inbox migration and rollout checks.
NOTIFICATION_INBOX_ENABLED=true
NOTIFICATION_INBOX_POLL_DELAY_MS=1000
NOTIFICATION_INBOX_BATCH_SIZE=50
NOTIFICATION_INBOX_MAX_ATTEMPTS=5
NOTIFICATION_INBOX_LEASE_SECONDS=30
NOTIFICATION_INBOX_INITIAL_RETRY_SECONDS=5
NOTIFICATION_INBOX_MAX_RETRY_SECONDS=300
NOTIFICATION_INBOX_RETRY_JITTER_SECONDS=3
NOTIFICATION_SESSION_REMINDER_POLL_DELAY_MS=60000
NOTIFICATION_SESSION_REMINDER_THRESHOLD_SECONDS=900
TENANT_APPLICATION_RESPONSE_SLA_HOURS=72

# -----------------------------------------------------------------------------
# Billing and PayOS
# -----------------------------------------------------------------------------
PAYOS_CLIENT_ID=__REQUIRED__
PAYOS_API_KEY=__REQUIRED__
PAYOS_CHECKSUM_KEY=__REQUIRED__
PAYOS_RETURN_URL=__REQUIRED__
PAYOS_CANCEL_URL=__REQUIRED__
PAYOS_BASE_URL=https://api-merchant.payos.vn
PAYOS_CONNECT_TIMEOUT_MS=2000
PAYOS_READ_TIMEOUT_MS=10000
PAYOS_PAYMENT_LINK_TTL_HOURS=24
BILLING_ORDER_PENDING_TTL_HOURS=24
BILLING_ORDER_EXPIRATION_CRON=0 0 * * * *
BILLING_LICENSE_CODE_EXPIRATION_CRON=0 15 * * * *
# How long a platform admin has to confirm a license-code revoke after previewing it.
BILLING_LICENSE_REVOKE_PREVIEW_TTL=5m

# -----------------------------------------------------------------------------
# Media (Cloudinary)
# -----------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=__REQUIRED__
CLOUDINARY_API_KEY=__REQUIRED__
CLOUDINARY_API_SECRET=__REQUIRED__
# One root folder per environment; local and production share the Cloudinary account, so never reuse a root.
# Files go to {root}/exam/questions, {root}/exam/answers, {root}/practice/questions, {root}/practice/recordings.
CLOUDINARY_ROOT_FOLDER=pte/local
# Nightly removal of unused files at Cloudinary (only under CLOUDINARY_ROOT_FOLDER). true in production, false locally.
MEDIA_PURGE_ENABLED=false
# Life of a signed upload or media link; also caps the link life every other module asks for.
CLOUDINARY_SIGNATURE_TTL_SECONDS=900

# -----------------------------------------------------------------------------
# Exam attempts
# -----------------------------------------------------------------------------
ATTEMPT_ALLOW_LEGACY_MISSING_MANIFEST=true
ATTEMPT_STRICT_PRE_FLIGHT_ENABLED=false
ATTEMPT_SECURITY_AUDIT_RETENTION_DAYS=180
ATTEMPT_SECURITY_AUDIT_RETENTION_CRON=0 0 2 * * *
# The built exam of a running attempt, cached in Redis, and the lock one builder holds while others wait.
ATTEMPT_CONTENT_CACHE_TTL=24h
ATTEMPT_CONTENT_CACHE_LOCK_TTL=10s
# Extra life of media links: on top of the session window at start, on top of the time left on reload.
ATTEMPT_MEDIA_URL_GRACE_SECONDS=60
ATTEMPT_MEDIA_URL_RELOAD_MARGIN_SECONDS=600
TASK_TYPES_CUSTOM_CREATION_ENABLED=false
IDEMPOTENCY_PURGE_CRON=0 15 3 * * *

# -----------------------------------------------------------------------------
# Practice app
# -----------------------------------------------------------------------------
PRACTICE_WEB_ENABLED=true
# Chat is fail-closed on entitlement: keep true wherever chat runs.
PRACTICE_STRICT_ENTITLEMENT_ENABLED=true
PRACTICE_ENTITLEMENT_REFRESH_SECONDS=300
PRACTICE_SCORING_RATE_LIMIT_PER_MINUTE=10
PRACTICE_SCORING_MAX_RETRIES=2
PRACTICE_SCORING_REDISPATCH_AFTER_SECONDS=100
PRACTICE_SCORING_MAX_AGE_SECONDS=180

# -----------------------------------------------------------------------------
# AI gateway (Capstone): question generation, its reviewer, the student chat and, with
# SCORING_AI_TEXT_VENDOR=gateway, the text part of AI scoring all use these three values (old names
# QUESTION_GEN_BASE_URL / _API_KEY / _GENERATOR_MODEL are still read as a fallback).
# -----------------------------------------------------------------------------
AI_GATEWAY_BASE_URL=__REQUIRED_FOR_AI__
# Optional: the gateway web page linked from the AI overview (default: the root of AI_GATEWAY_BASE_URL host).
AI_GATEWAY_WEB_URL=
AI_GATEWAY_API_KEY=__REQUIRED_FOR_AI__
AI_GATEWAY_MODEL=Capstone
QUESTION_GEN_REVIEWER_MODEL=Capstone
# Text-to-image model of the same gateway for Describe Image pictures, and the paint attempts
# (provider failures or reviewer refusals) before a picture question is made as a chart instead.
QUESTION_GEN_IMAGE_MODEL=ag/gemini-3.1-flash-image
QUESTION_GEN_IMAGE_MAX_ATTEMPTS=2

# -----------------------------------------------------------------------------
# AI question generation
# -----------------------------------------------------------------------------
QUESTION_GEN_ENABLED=false
# Deterministic stub generator: test, local and local-schema profiles only.
QUESTION_GEN_STUB=false
QUESTION_GEN_GENERATOR_TEMPERATURE=0.8
QUESTION_GEN_REVIEWER_TEMPERATURE=0.0
# 0 = no output-token cap.
QUESTION_GEN_MAX_TOKENS=0
QUESTION_GEN_CONNECT_TIMEOUT=5s
QUESTION_GEN_READ_TIMEOUT=90s
QUESTION_GEN_RETRY_DELAY=2s
# Only for the AI overview cost estimate (USD per million tokens).
QUESTION_GEN_PRICE_INPUT_PER_MILLION_USD=0.10
QUESTION_GEN_PRICE_OUTPUT_PER_MILLION_USD=0.40
QUESTION_GEN_MAX_ITEMS_PER_JOB=10
QUESTION_GEN_MAX_ITEMS_PER_USER_PER_DAY=100
QUESTION_GEN_MAX_ITEMS_PER_DAY_GLOBAL=300
QUESTION_GEN_MAX_CONCURRENT_JOBS=3
QUESTION_GEN_MAX_CALLS_PER_ITEM=40
QUESTION_GEN_MAX_CALLS_PER_ROUND=5
QUESTION_GEN_CONSECUTIVE_FAILURES_TO_STOP=3
QUESTION_GEN_POLL_DELAY_MS=3000
QUESTION_GEN_LEASE_DURATION=10m
# Image reviewer: a model looks at each drawn chart next to its data before the question is saved.
QUESTION_GEN_VISION_CHECK=false
# Live view of a running job (server-sent events).
QUESTION_GEN_LIVE_STREAM_TIMEOUT_MS=1800000
QUESTION_GEN_LIVE_HEARTBEAT_MS=15000
QUESTION_GEN_LIVE_FINISHED_RETENTION_MS=600000
QUESTION_GEN_LIVE_IDLE_RETENTION_MS=1800000
# Text-to-speech for listening items (Kokoro). Empty base URL = audio task types cannot be generated.
KOKORO_BASE_URL=
# Optional: the speech web page linked from the AI overview (default: KOKORO_BASE_URL + /web/).
KOKORO_WEB_URL=
KOKORO_API_KEY=
KOKORO_TIMEOUT=300s
QUESTION_GEN_VOICES_US=af_heart,af_bella,am_michael
QUESTION_GEN_VOICES_UK=bf_emma,bm_george

# -----------------------------------------------------------------------------
# Student chat (uses the AI gateway above; no key of its own)
# -----------------------------------------------------------------------------
CHAT_AI_ENABLED=false
NEXT_PUBLIC_CHAT_ENABLED=true
CHAT_AI_TEMPERATURE=0.2
CHAT_AI_CONNECT_TIMEOUT_MS=2000
CHAT_AI_READ_TIMEOUT_MS=90000
CHAT_AI_DAILY_LIMIT=20
CHAT_AI_MAX_INPUT_CHARS=1000
CHAT_AI_HISTORY_SIZE=6
CHAT_AI_MAX_CONCURRENT=20
# Only for the admin cost estimate (USD per million tokens). 0 when the gateway does not bill per token.
CHAT_AI_PRICE_INPUT_PER_MILLION_USD=0.10
CHAT_AI_PRICE_OUTPUT_PER_MILLION_USD=0.40

# -----------------------------------------------------------------------------
# AI scoring
# stub = no AI (development). azure-gemini = Azure Speech scores the audio; with SCORING_AI_TEXT_VENDOR=gateway the
# AI gateway above (Capstone) reads transcripts, essays and pictures. SCORING_AI_GATEWAY_TIMEOUT_MS is that call's timeout.
# -----------------------------------------------------------------------------
SCORING_AI_PROVIDER=stub
SCORING_AI_TEXT_VENDOR=gateway
AZURE_SPEECH_KEY=__REQUIRED_FOR_AZURE__
AZURE_SPEECH_REGION=southeastasia
SCORING_AI_AZURE_TIMEOUT_MS=60000
SCORING_AI_GATEWAY_TIMEOUT_MS=60000
# Practice speaking: gateway = the model above hears the recording with the Pearson rubric and writes feedback;
# azure = Azure Speech as in exams. Exams always use Azure.
SCORING_AI_PRACTICE_SPEECH_VENDOR=gateway
SCORING_AI_MEDIA_URL_TTL_SECONDS=120
SCORING_AI_CONNECT_TIMEOUT_MS=2000
SCORING_AI_JOB_BUDGET_MS=90000
SCORING_AI_STALE_DISPATCH_MINUTES=10
SCORING_AI_RETRY_MAX_ATTEMPTS=3
SCORING_AI_BREAKER_THRESHOLD=5
# Post-CLOSED grading reconciliation; keep at or below 60000 ms.
SCORING_GRADING_RECONCILIATION_POLL_DELAY_MS=60000

# -----------------------------------------------------------------------------
# Vietnam address lookup (organization onboarding)
# -----------------------------------------------------------------------------
VIETNAM_LOCATION_BASE_URL=https://provinces.open-api.vn/api/v2
VIETNAM_LOCATION_CONNECT_TIMEOUT_MS=2000
VIETNAM_LOCATION_READ_TIMEOUT_MS=10000
VIETNAM_LOCATION_CACHE_TTL_MS=86400000
