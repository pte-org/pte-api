      "applicable": true,
      "confidence": "high",
      "location": "proctor/src/main/java/com/pte/proctor/config/WebSocketConfig.java",
      "evidence": "registry.addEndpoint(\"/ws\").setAllowedOriginPatterns(\"*\") permitted the STOMP handshake from any origin.",
      "why_it_matters": "JWT-on-CONNECT is the primary defense, but an unrestricted origin policy removes a cheap first line of defense against a malicious page opening a WS connection.",
      "required_action": "Replaced the hardcoded \"*\" with a configurable proctor.ws.allowed-origin-patterns property (default http://localhost:* for local dev), injected via @Value into WebSocketConfig.",
      "owner": "cook"
    },
